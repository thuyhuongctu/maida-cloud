# Database
DATABASE_URL="postgresql://user:password@localhost:5432/maida_cloud?schema=public"

# LLM provider (vendor neutral). Configure your own provider and key.
# The extractor calls an OpenAI-compatible chat completion endpoint.
LLM_BASE_URL="https://your-provider.example.com/v1"
LLM_API_KEY="replace-with-your-provider-key"
LLM_MODEL="replace-with-your-approved-model-id"

# Auth (generate a long random string, e.g. openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"

# Billing (optional until you go live). The plan and quota system works
# without these; configure them to enable paid upgrades through Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# App
APP_URL="http://localhost:3000"
